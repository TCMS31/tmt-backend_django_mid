# Copy to `.env` and edit. `.env` is git-ignored and must never be committed.
# Values already present in the real environment always win over this file.

# --- Django ---------------------------------------------------------------
# Required in production; `config.settings.local` falls back to a development
# placeholder. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# --- Database -------------------------------------------------------------
# Leave POSTGRES_DB empty to fall back to SQLite at SQLITE_PATH.
POSTGRES_DB=tmt_interview
POSTGRES_USER=docker
POSTGRES_PASSWORD=docker
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5444
DB_CONN_MAX_AGE=60

# --- API ------------------------------------------------------------------
INVENTORY_PAGE_SIZE=3
API_PAGE_SIZE=25

# --- Container ports (docker-compose.yml) ---------------------------------
API_HOST_PORT=8960
POSTGRES_HOST_PORT=5444
